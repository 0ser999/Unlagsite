{
  "redirects": [
    {
      "source": "/discord",
      "destination": "https://discord.gg/8eMpzNCErW",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "download.unlag.pro"
        }
      ],
      "destination": "https://github.com/0ser999/unlag/releases/latest/download/unlag.exe",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(hero-mouse.webp|logo.png|og.jpg|app-home.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
